rules_version = '2';

// Street Gymnastics: who may read and write what (docs/TIERS.md, "Pro account setup").
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone the app signed in, the anonymous user included (the owner, 2026-10-31): any athlete picks a username
    // without Google, and Google linked later keeps the same uid, so the name, profile and score stay theirs.
    function authed() {
      return request.auth != null;
    }

    // A Google account: the only one that keeps cloud progress, which an anonymous user would lose with the phone.
    function google() {
      return authed() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Leaderboards: the app reads them without signing in (Plus); only the scheduled function writes them.
    match /boards/{board} {
      allow get: if true;
      allow list, write: if false;
    }

    // The function's own bookkeeping.
    match /meta/{doc} {
      allow read, write: if false;
    }

    // A username belongs to one account: claimed once, released only by its owner.
    match /usernames/{name} {
      allow get: if authed();
      // Claimed only together with the profile that uses it, so one account can't hoard names.
      allow create: if authed()
        && name.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.lower() == name;
      allow delete: if authed() && resource.data.uid == request.auth.uid;
      allow list, update: if false;
    }

    // A profile, any athlete's: its username must be the one this account holds.
    match /users/{uid} {
      allow get, delete: if authed() && request.auth.uid == uid;
      allow create, update: if authed() && request.auth.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_.]{3,20}$')
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == uid
        && request.resource.data.country is string && request.resource.data.country.matches('^[A-Z]{2}$')
        && request.resource.data.visible is bool;
      allow list: if false;

      // Cloud progress (Pro): only its owner reads or writes it, with Google.
      match /data/{doc} {
        allow read, write: if google() && request.auth.uid == uid && doc in ['progress', 'library'];
      }
    }

    // Public scores (version 4, the owner, 2026-10-31): all-time points and this month's (functions/boards.py), written
    // by their owner, anonymous or Google, under their profile's name, which the account still holds, and read only by
    // the function. month is the UTC month month_points belong to. The time is the server's, so the function's "changed
    // since the last run" check can't be gamed.
    match /scores/{uid} {
      allow create, update: if authed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'username', 'country', 'points', 'month', 'month_points', 'updated_at'])
        && request.resource.data.v == 4
        && request.resource.data.username == get(/databases/$(database)/documents/users/$(uid)).data.username
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == uid
        && request.resource.data.updated_at == request.time
        && request.resource.data.country is string && request.resource.data.country.matches('^[A-Z]{2}$')
        && request.resource.data.points is int
        && request.resource.data.points >= 0 && request.resource.data.points <= 100000000
        && request.resource.data.month is string && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.month_points is int
        && request.resource.data.month_points >= 0 && request.resource.data.month_points <= request.resource.data.points;
      allow delete: if authed() && request.auth.uid == uid;
      allow read: if false;
    }

    // Progress analytics (the owner, 2026-10-30; docs/TIERS.md, "Progress analytics"): every tier's training progress
    // under the install's random code (a UUID), while "Share my progress" is on. Any signed-in user, the anonymous one
    // included, may write or delete an install whose code it knows; nobody reads. accountUid is only ever the writer's
    // own Google account, and leaving it out keeps it. Times are the server's, sizes are capped.
    match /analytics/{installId} {
      allow create: if request.auth != null && validInstallId(installId)
        && validInstall(request.resource.data) && ownAccount(request.resource.data);
      allow update: if request.auth != null && validInstallId(installId)
        && validInstall(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountUid'])
          || ownAccount(request.resource.data));
      allow delete: if request.auth != null && validInstallId(installId);
      allow read: if false;

      // One finished class, by the millisecond it started.
      match /sessions/{sessionId} {
        allow create, update: if request.auth != null && validInstallId(installId)
          && sessionId.matches('^[0-9]{10,15}$') && validSession(request.resource.data);
        allow delete: if request.auth != null && validInstallId(installId) && sessionId.matches('^[0-9]{10,15}$');
        allow read: if false;
      }
    }

    function validInstallId(id) {
      return id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
    }

    function optionalCount(data, key, most) {
      return data.get(key, null) == null || data[key] is int && data[key] >= 0 && data[key] <= most;
    }

    // No accountUid, or the signed-in Google account's own.
    function ownAccount(data) {
      return !('accountUid' in data) || google() && data.accountUid == request.auth.uid;
    }

    function validInstall(data) {
      return data.keys().hasOnly(['v', 'appSetId', 'appSetScope', 'accountUid', 'firstSeen', 'lastSeen', 'versionName',
          'versionCode', 'tier', 'debug', 'shareProgress', 'placement', 'skills', 'score', 'switches', 'completedClasses',
          'trainedClasses', 'markedClasses', 'atLevel', 'atDay'])
        && data.keys().hasAll(['v', 'firstSeen', 'lastSeen', 'versionName', 'versionCode', 'tier', 'debug', 'shareProgress'])
        && data.v == 1
        && data.lastSeen == request.time
        && data.firstSeen is timestamp
        && data.versionName is string && data.versionName.size() <= 32
        && data.versionCode is int
        && data.tier in ['free', 'plus', 'pro']
        && data.debug is bool
        && data.shareProgress == true
        && (data.get('appSetId', null) == null || data.appSetId is string && data.appSetId.size() <= 64)
        && (data.get('appSetScope', null) == null || data.appSetScope in ['developer', 'app'])
        && (data.get('placement', null) == null || data.placement is map
          && data.placement.keys().hasOnly(['pullUps', 'pushUps', 'squats', 'skillTest', 'startLevel', 'startDay']))
        && (data.get('skills', null) == null || data.skills is map && data.skills.size() <= 64)
        && (data.get('score', null) == null || data.score is int && data.score >= 0 && data.score <= 1000)
        && (data.get('switches', null) == null || data.switches is string && data.switches.size() <= 400)
        && optionalCount(data, 'completedClasses', 100000)
        && optionalCount(data, 'trainedClasses', 100000)
        && optionalCount(data, 'markedClasses', 100000)
        && optionalCount(data, 'atLevel', 20)
        && optionalCount(data, 'atDay', 1000);
    }

    // Each exercise with its sets (planned, done, ticked); a class has at most 33 exercises.
    function validSession(data) {
      return data.keys().hasOnly(['v', 'programId', 'level', 'day', 'dayType', 'exam', 'custom', 'repeat', 'intensity',
          'effort', 'startedAt', 'finishedAt', 'durationSec', 'plannedSets', 'doneSets', 'leftOutSets', 'exercises',
          'uploadedAt'])
        && data.keys().hasAll(['v', 'programId', 'level', 'day', 'exam', 'custom', 'repeat', 'intensity', 'startedAt',
          'finishedAt', 'durationSec', 'plannedSets', 'doneSets', 'leftOutSets', 'exercises', 'uploadedAt'])
        && data.v == 1
        && data.programId is string && data.programId.matches('^(sg:l[0-9]{2}:p[0-9]{4}|ready:[a-z0-9_]{1,40}|custom|unknown)$')
        && optionalCount(data, 'level', 20)
        && optionalCount(data, 'day', 1000)
        && (data.get('dayType', null) == null || data.dayType is string && data.dayType.matches('^[a-z0-9_]{1,64}$'))
        && data.exam is bool && data.custom is bool && data.repeat is bool
        && data.intensity in ['easier', 'normal', 'harder']
        && (data.get('effort', null) == null || data.effort is int && data.effort >= 1 && data.effort <= 10)
        && data.startedAt is timestamp && data.finishedAt is timestamp
        && data.durationSec is int && data.durationSec >= 0
        && optionalCount(data, 'plannedSets', 1000)
        && optionalCount(data, 'doneSets', 1000)
        && optionalCount(data, 'leftOutSets', 1000)
        && data.exercises is list && data.exercises.size() <= 60
        && data.uploadedAt == request.time;
    }
  }
}
