<?xml version="1.0" encoding="utf-8"?>
<!--
    The "Next class" card for a cell under 100 dp tall (a landscape home screen): the same card at 54 dp, with a 46 dp
    tile and a 34 dp start square, and without the third line. Same ids as widget_next_class.xml; NextClassWidget fills
    both alike.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="center_vertical">

        <FrameLayout
            android:id="@+id/widget_shadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:background="#FF121212" />

        <FrameLayout
            android:id="@+id/widget_outline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:background="#FF121212"
            android:padding="2dp">

            <LinearLayout
                android:id="@+id/widget_card"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFF5F4F0"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="8dp">

                <FrameLayout
                    android:id="@+id/widget_tile"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="#FF121212"
                    android:padding="2dp">

                    <ViewFlipper
                        android:id="@+id/widget_figure"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autoStart="true"
                        android:background="#FFE9E7E2"
                        android:flipInterval="125" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/widget_tape"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/widget_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:letterSpacing="0.06"
                            android:maxLines="1"
                            android:textColor="#FF4A4945"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/widget_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no"
                        android:scaleType="fitStart" />

                    <TextView
                        android:id="@+id/widget_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/widget_action_outline"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="#FF121212"
                    android:padding="2dp">

                    <ImageView
                        android:id="@+id/widget_action"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#FFFFD60A"
                        android:importantForAccessibility="no"
                        android:scaleType="center"
                        android:src="@drawable/widget_play" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
