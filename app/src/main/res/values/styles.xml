<resources>
    <!-- Night Park, the dark look. -->
    <style name="Theme.StreetNight" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/street_dark_background</item>
        <item name="android:colorAccent">@color/street_dark_primary</item>
        <item name="android:statusBarColor">@color/street_dark_background</item>
        <item name="android:navigationBarColor">@color/street_dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/StreetDialog.dark</item>
    </style>
    <style name="StreetDialog.dark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_dark</item>
        <item name="android:colorAccent">@color/street_dark_primary</item>
    </style>
    <!-- Concrete & Tape, the default. -->
    <style name="Theme.StreetConcrete" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/street_concrete_background</item>
        <item name="android:colorAccent">@color/street_concrete_primary</item>
        <item name="android:statusBarColor">@color/street_concrete_background</item>
        <item name="android:navigationBarColor">@color/street_concrete_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:alertDialogTheme">@style/StreetDialog.concrete</item>
    </style>
    <style name="StreetDialog.concrete" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_concrete</item>
        <item name="android:colorAccent">@color/street_concrete_primary</item>
    </style>
    <!-- Wheatpaste. -->
    <style name="Theme.StreetPaste" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/street_paste_background</item>
        <item name="android:colorAccent">@color/street_paste_primary</item>
        <item name="android:statusBarColor">@color/street_paste_background</item>
        <item name="android:navigationBarColor">@color/street_paste_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:alertDialogTheme">@style/StreetDialog.paste</item>
    </style>
    <style name="StreetDialog.paste" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_paste</item>
        <item name="android:colorAccent">@color/street_paste_primary</item>
    </style>
</resources>
